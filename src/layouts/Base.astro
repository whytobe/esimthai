---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  type = 'website',
  publishedTime,
  noindex = false,
  jsonLd,
} = Astro.props;

const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? 'https://esim.whytobe.com'
).toString();
---

<!doctype html>
<html lang="th">
  <head>
    <meta name="impact-site-verification" value="d2786f61-3fe4-4810-b016-b9cb6a07cbab" />
    <script
      defer
      data-noptimize="1"
      data-cfasync="false"
      data-wpfc-render="false"
      src="https://tpembars.com/NjA3MjEw.js?t=607210"
    ></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — eSIMไทย</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="eSIMไทย" />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://esim.whytobe.com/og-default.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content="https://esim.whytobe.com/og-default.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/">
          <img src="/favicon.svg" alt="" width="26" height="26" class="brand__mark" />
          <span>eSIMไทย<span class="brand__dot"></span></span>
        </a>
        <nav class="nav" aria-label="เมนูหลัก">
          <a href="/">บทความ</a>
          <a href="/blog/what-is-esim/">เช็กมือถือ</a>
          <a href="/blog/where-to-buy-esim/">เทียบ 5 ค่าย</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="shell"><slot /></div>
    </main>
    <footer class="site-footer">
      <div class="shell">
        <p>
          ราคาและแพ็กเกจเปลี่ยนแปลงได้บ่อย — เช็กข้อมูลล่าสุดในลิงก์ก่อนตัดสินใจเสมอ
          ลิงก์บางส่วนเป็นลิงก์ affiliate
        </p>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const clean = (v) => (v || '').trim().replace(/[^a-zA-Z0-9._-]/g, '-').slice(0, 32);
        const params = new URLSearchParams(window.location.search);
        const parts = [
          clean(params.get('utm_source')),
          clean(params.get('utm_campaign')),
          clean(params.get('utm_content')),
        ].filter(Boolean);
        let attrTag = parts.join('__').slice(0, 64);
        try {
          if (attrTag) {
            window.sessionStorage.setItem('spn_attr', attrTag);
          } else {
            attrTag = window.sessionStorage.getItem('spn_attr') || '';
          }
        } catch {}

        const applySubId3 = (anchor) => {
          if (!attrTag || !(anchor instanceof HTMLAnchorElement)) return;
          try {
            const url = new URL(anchor.href);
            if (url.hostname === 'airalo.pxf.io') {
              url.searchParams.set('subId3', attrTag);
              anchor.href = url.toString();
            }
          } catch {}
        };

        if (attrTag) {
          document.querySelectorAll('a[href*="airalo.pxf.io"]').forEach(applySubId3);
        }

        document.addEventListener('click', (event) => {
          const anchor = event.target instanceof Element ? event.target.closest('a[href]') : null;
          if (anchor) applySubId3(anchor);

          const btn = event.target instanceof Element ? event.target.closest('[data-copy]') : null;
          if (!btn) return;
          const value = btn.getAttribute('data-copy');
          if (!value || !navigator.clipboard) return;
          const original = btn.textContent;
          navigator.clipboard
            .writeText(value)
            .then(() => {
              btn.textContent = 'คัดลอกแล้ว';
              window.setTimeout(() => {
                btn.textContent = original;
              }, 1800);
            })
            .catch(() => {});
        });
      })();
    </script>
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token":"616ef818d42443429ee1449c6f2836b2"}'
    ></script>
  </body>
</html>
