---
import { VACAY_CODE, discountedThbPrice, vacayUrlFor } from '../lib/affiliate';

interface Props {
  link: string;
  name: string;
  data: string;
  days: string;
  price: string;
  code?: string;
  slug?: string;
}

const { link, name, data, days, price, code, slug } = Astro.props;
const discounted = code ? discountedThbPrice(price, 15) : undefined;
const vacayHref = vacayUrlFor(slug);
---

<div class="ticket">
  <div class="ticket__main">
    <h3>{name}</h3>
    <p>แพ็กเกจคุ้มสำหรับทริป {days} — ต่อเน็ตทันทีหลังถึง ไม่ต้องเปลี่ยนซิม</p>
    <div class="ticket__actions">
      <a
        class="btn"
        href={link}
        data-partner="airalo"
        data-autocopy={code || undefined}
        rel="sponsored nofollow noopener"
        target="_blank"
      >
        {code ? 'คัดลอกโค้ด + สมัคร Airalo' : 'ดูราคาและสมัคร Airalo'}
      </a>
      <a
        class="btn btn--secondary"
        href={vacayHref}
        data-partner="vacay"
        data-autocopy={VACAY_CODE}
        rel="sponsored nofollow noopener"
        target="_blank"
      >
        ดูแพ็ก Vacay (PromptPay)
      </a>
    </div>
    {code && (
      <p class="affiliate-note">
        Airalo ลด 15%: <code>{code}</code>{' '}
        <button
          class="copy-code"
          type="button"
          data-copy={code}
          aria-label={`คัดลอกโค้ดส่วนลด Airalo ${code}`}
        >
          คัดลอกโค้ด
        </button>
        {' · '}Vacay จ่าย PromptPay โค้ด: <code>{VACAY_CODE}</code>{' '}
        <button
          class="copy-code"
          type="button"
          data-copy={VACAY_CODE}
          aria-label={`คัดลอกโค้ดส่วนลด Vacay ${VACAY_CODE}`}
        >
          คัดลอกโค้ด
        </button>
      </p>
    )}
  </div>
  <div class="ticket__stub">
    <span class="ticket__stub-label">เน็ต</span>
    <span class="ticket__stub-data">{data}</span>
    <span class="ticket__stub-label">วัน</span>
    <span class="ticket__stub-data">{days}</span>
    <span class="ticket__stub-label">{discounted ? 'ลด 15% เหลือ' : 'ราคา'}</span>
    <span class="ticket__stub-price">
      {discounted ? (
        <>
          <s class="ticket__old-price">{price}</s> {discounted}
        </>
      ) : (
        price
      )}
    </span>
  </div>
</div>
