    link: 'https://airalo.pxf.io/OYqz9A?subId1=home-picker&subId2=singapore',
    guide: '/blog/esim-singapore/',
    tiers: {
      light: { data: '3 GB', days: '7 วัน', price: '฿245', disc: '~฿208' },
      standard: { data: '5 GB', days: '7 วัน', price: '฿315', disc: '~฿268' },
