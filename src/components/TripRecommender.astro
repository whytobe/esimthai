    guide: '/blog/esim-hong-kong/',
    tiers: {
      light: { data: '3 GB', days: '7 วัน', price: '฿297.50', disc: '~฿253' },
      standard: { data: '5 GB', days: '7 วัน', price: '฿384.50', disc: '~฿327' },
