---
import Base from './Base.astro';
import QuickPick from '../components/QuickPick.astro';
import TicketCta from '../components/TicketCta.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { withSubId } from '../lib/affiliate';

interface Props {
  post: CollectionEntry<'blog'>;
  Content: unknown;
}

const { post, Content } = Astro.props;
const { title, description, date, affiliate, recommend } = post.data;
const dateStr = date.toLocaleDateString('th-TH', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const topLink = affiliate ? withSubId(affiliate.link, post.id, 'top') : undefined;
const bottomLink = affiliate ? withSubId(affiliate.link, post.id, 'bottom') : undefined;

const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? 'https://esim.whytobe.com'
).toString();

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: date.toISOString(),
  inLanguage: 'th-TH',
  mainEntityOfPage: canonicalUrl,
  publisher: {
    '@type': 'Organization',
    name: 'eSIMไทย',
    url: 'https://esim.whytobe.com',
  },
};

const relatedPosts = (await getCollection('blog'))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base
  title={title}
  description={description}
  type="article"
  publishedTime={date.toISOString()}
  jsonLd={articleJsonLd}
>
  <article>
    <header class="article-head">
      <h1>{title}</h1>
      <div class="article-head__meta">
        <time datetime={date.toISOString()}>{dateStr}</time>
        {post.data.tags.map((tag: string) => <span>{tag}</span>)}
      </div>
    </header>

    {
      topLink && recommend && (
        <QuickPick
          link={topLink}
          name={recommend.name}
          data={recommend.data}
          days={recommend.days}
          price={recommend.price}
          code={affiliate?.code}
        />
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      bottomLink && recommend && (
        <TicketCta
          link={bottomLink}
          name={recommend.name}
          data={recommend.data}
          days={recommend.days}
          price={recommend.price}
          code={affiliate?.code}
        />
      )
    }

    {
      relatedPosts.length > 0 && (
        <section class="related" aria-label="บทความที่เกี่ยวข้อง">
          <div class="board-label">บทความที่เกี่ยวข้อง</div>
          <ul class="post-list">
            {relatedPosts.map((other) => (
              <li>
                <a href={`/blog/${other.id}/`}>
                  <span class="post-list__title">{other.data.title}</span>
                  <span class="post-list__meta">
                    {other.data.date.toLocaleDateString('th-TH', {
                      day: 'numeric',
                      month: 'short',
                      year: 'numeric',
                    })}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>
