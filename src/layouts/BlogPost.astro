---
import Base from './Base.astro';
import QuickPick from '../components/QuickPick.astro';
import TicketCta from '../components/TicketCta.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { VACAY_CODE, discountedThbPrice, vacayUrlFor, withSubId } from '../lib/affiliate';

interface Props {
  post: CollectionEntry<'blog'>;
  Content: unknown;
}

const { post, Content } = Astro.props;
const { title, description, date, updatedDate, affiliate, recommend, faqs } = post.data;
const effectiveModified = updatedDate ?? date;
const dateStr = date.toLocaleDateString('th-TH', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const updatedDateStr = updatedDate?.toLocaleDateString('th-TH', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const topLink = affiliate ? withSubId(affiliate.link, post.id, 'top') : undefined;
const bottomLink = affiliate ? withSubId(affiliate.link, post.id, 'bottom') : undefined;
const stickyLink = affiliate ? withSubId(affiliate.link, post.id, 'sticky') : undefined;
const vacayHref = vacayUrlFor(post.id);
const stickyPrice = recommend
  ? (affiliate?.code ? discountedThbPrice(recommend.price, 15) : undefined) ?? recommend.price
  : undefined;

const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? 'https://esim.whytobe.com'
).toString();

const graphNodes: Record<string, unknown>[] = [
  {
    '@type': 'Article',
    headline: title,
    description,
    image: 'https://esim.whytobe.com/og-default.png',
    datePublished: date.toISOString(),
    dateModified: effectiveModified.toISOString(),
    inLanguage: 'th-TH',
    mainEntityOfPage: canonicalUrl,
    publisher: {
      '@type': 'Organization',
      name: 'eSIMไทย',
      url: 'https://esim.whytobe.com',
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'หน้าแรก',
        item: 'https://esim.whytobe.com/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: title,
        item: canonicalUrl,
      },
    ],
  },
];

if (faqs && faqs.length > 0) {
  graphNodes.push({
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  });
}

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@graph': graphNodes,
};

const currentTags = new Set(post.data.tags.map((t: string) => t.trim().toLowerCase()));
const relatedPosts = (await getCollection('blog'))
  .filter((p) => p.id !== post.id)
  .map((p) => {
    const overlap = p.data.tags.reduce(
      (acc: number, t: string) => acc + (currentTags.has(t.trim().toLowerCase()) ? 1 : 0),
      0
    );
    const recency = (p.data.updatedDate ?? p.data.date).getTime();
    return { post: p, overlap, recency };
  })
  .sort((a, b) => b.overlap - a.overlap || b.recency - a.recency)
  .slice(0, 6)
  .map((item) => item.post);
---

<Base
  title={title}
  description={description}
  type="article"
  publishedTime={date.toISOString()}
  modifiedTime={updatedDate?.toISOString()}
  jsonLd={articleJsonLd}
>
  <article>
    <header class="article-head">
      <h1>{title}</h1>
      <div class="article-head__meta">
        <time datetime={date.toISOString()}>{dateStr}</time>
        {updatedDate && updatedDateStr && (
          <time datetime={updatedDate.toISOString()}>อัปเดต {updatedDateStr}</time>
        )}
        {post.data.tags.map((tag: string) => <span>{tag}</span>)}
      </div>
    </header>

    {
      topLink && recommend && (
        <QuickPick
          link={topLink}
          name={recommend.name}
          data={recommend.data}
          days={recommend.days}
          price={recommend.price}
          code={affiliate?.code}
          slug={post.id}
        />
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      faqs && faqs.length > 0 && (
        <section class="faq-accordion" aria-labelledby="faq-heading">
          <h2 id="faq-heading">คำถามด่วนก่อนสั่งซื้อ</h2>
          <div class="faq-accordion__list">
            {faqs.map((item) => (
              <details class="faq-item">
                <summary class="faq-item__summary">{item.q}</summary>
                <div class="faq-item__body">
                  <p>{item.a}</p>
                </div>
              </details>
            ))}
          </div>
        </section>
      )
    }

    {
      bottomLink && recommend && (
        <TicketCta
          link={bottomLink}
          name={recommend.name}
          data={recommend.data}
          days={recommend.days}
          price={recommend.price}
          code={affiliate?.code}
          slug={post.id}
        />
      )
    }

    {
      stickyLink && recommend && stickyPrice && (
        <aside class="sticky-cta" data-sticky-cta aria-label="ทางลัดสั่งซื้อแพ็กแนะนำ" hidden>
          <div class="sticky-cta__info">
            <strong class="sticky-cta__name">{recommend.name}</strong>
            <span class="sticky-cta__meta">
              {recommend.data}/{recommend.days} · <strong>{stickyPrice}</strong>
            </span>
          </div>
          <div class="sticky-cta__actions">
            <a
              class="btn sticky-cta__btn"
              href={stickyLink}
              data-partner="airalo"
              data-autocopy={affiliate?.code || undefined}
              rel="sponsored nofollow noopener"
              target="_blank"
            >
              ไปหน้า Airalo
            </a>
            <a
              class="btn btn--secondary sticky-cta__btn"
              href={vacayHref}
              data-partner="vacay"
              data-autocopy={VACAY_CODE}
              rel="sponsored nofollow noopener"
              target="_blank"
            >
              PromptPay
            </a>
          </div>
        </aside>
      )
    }

    {
      relatedPosts.length > 0 && (
        <section class="related" aria-label="บทความที่เกี่ยวข้อง">
          <div class="board-label">บทความที่เกี่ยวข้อง</div>
          <ul class="post-list">
            {relatedPosts.map((other) => (
              <li>
                <a href={`/blog/${other.id}/`}>
                  <span class="post-list__title">{other.data.title}</span>
                  <span class="post-list__meta">
                    {other.data.date.toLocaleDateString('th-TH', {
                      day: 'numeric',
                      month: 'short',
                      year: 'numeric',
                    })}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>
