---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  type = 'website',
  publishedTime,
  noindex = false,
  jsonLd,
} = Astro.props;

const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? 'https://esim.whytobe.com'
).toString();
---

<!doctype html>
<html lang="th">
  <head>
    <meta name="impact-site-verification" value="d2786f61-3fe4-4810-b016-b9cb6a07cbab" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} — eSIMไทย</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="eSIMไทย" />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://esim.whytobe.com/og-default.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content="https://esim.whytobe.com/og-default.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://connect.facebook.net" />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/">
          <img src="/favicon.svg" alt="" width="26" height="26" class="brand__mark" />
          <span>eSIMไทย<span class="brand__dot"></span></span>
        </a>
        <nav class="nav" aria-label="เมนูหลัก">
          <a href="/">บทความ</a>
          <a href="/blog/what-is-esim/">เช็กมือถือ</a>
          <a href="/blog/where-to-buy-esim/">เทียบ 5 ค่าย</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="shell"><slot /></div>
    </main>
    <footer class="site-footer">
      <div class="shell">
        <p>
          ราคาและแพ็กเกจเปลี่ยนแปลงได้บ่อย — เช็กข้อมูลล่าสุดในลิงก์ก่อนตัดสินใจเสมอ
          ลิงก์บางส่วนเป็นลิงก์ affiliate
        </p>
      </div>
    </footer>
    <span class="visually-hidden" role="status" aria-live="polite" data-copy-live></span>
    <div class="copy-toast" data-copy-toast aria-hidden="true"></div>
    <script is:inline>
      (() => {
        const PIXEL_ID = '1204328895355336';
        const clean = (v) => (v || '').trim().replace(/[^a-zA-Z0-9._-]/g, '-').slice(0, 32);
        const params = new URLSearchParams(window.location.search);
        const utmFromUrl = {
          utm_source: clean(params.get('utm_source')),
          utm_medium: clean(params.get('utm_medium')),
          utm_campaign: clean(params.get('utm_campaign')),
          utm_content: clean(params.get('utm_content')),
        };
        const hasUrlUtm = Boolean(
          utmFromUrl.utm_source || utmFromUrl.utm_campaign || utmFromUrl.utm_content
        );

        let utm = utmFromUrl;
        try {
          if (hasUrlUtm) {
            window.sessionStorage.setItem('spn_utm', JSON.stringify(utmFromUrl));
          } else {
            const saved = window.sessionStorage.getItem('spn_utm');
            if (saved) {
              const parsed = JSON.parse(saved);
              utm = {
                utm_source: clean(parsed.utm_source),
                utm_medium: clean(parsed.utm_medium),
                utm_campaign: clean(parsed.utm_campaign),
                utm_content: clean(parsed.utm_content),
              };
            }
          }
        } catch {}

        const parts = [utm.utm_source, utm.utm_campaign, utm.utm_content].filter(Boolean);
        let attrTag = parts.join('__').slice(0, 64);
        try {
          if (attrTag) {
            window.sessionStorage.setItem('spn_attr', attrTag);
          } else {
            attrTag = window.sessionStorage.getItem('spn_attr') || '';
          }
        } catch {}

        // Meta Pixel (SimPaiNai Web) loaded asynchronously near footer
        if (!window.fbq) {
          const n = function () {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
          };
          if (!window._fbq) window._fbq = n;
          n.push = n;
          n.loaded = true;
          n.version = '2.0';
          n.queue = [];
          window.fbq = n;
          const t = document.createElement('script');
          t.async = true;
          t.src = 'https://connect.facebook.net/en_US/fbevents.js';
          const s = document.getElementsByTagName('script')[0];
          if (s && s.parentNode) {
            s.parentNode.insertBefore(t, s);
          } else {
            document.head.appendChild(t);
          }
        }
        window.fbq('init', PIXEL_ID);
        window.fbq('track', 'PageView');

        const detectPartner = (hostname) => {
          const host = hostname.toLowerCase();
          if (host === 'airalo.pxf.io') return 'airalo';
          if (host === 'esim.vacay.asia' || host.endsWith('.vacay.asia')) return 'vacay';
          if (host === 'tp.media' || host.endsWith('.tp.media')) return 'travelpayouts';
          if (host === 'saily.com' || host.endsWith('.saily.com')) return 'saily';
          if (host === 'klook.com' || host.endsWith('.klook.com')) return 'klook';
          return '';
        };

        const applySubId3 = (anchor) => {
          if (!attrTag || !(anchor instanceof HTMLAnchorElement)) return;
          try {
            const url = new URL(anchor.href);
            if (url.hostname === 'airalo.pxf.io') {
              url.searchParams.set('subId3', attrTag);
              anchor.href = url.toString();
            }
          } catch {}
        };

        window.__spnApplySubId3 = applySubId3;

        if (attrTag) {
          document.querySelectorAll('a[href*="airalo.pxf.io"]').forEach(applySubId3);
        }

        const liveRegion = document.querySelector('[data-copy-live]');
        const copyToast = document.querySelector('[data-copy-toast]');
        let toastTimer = 0;
        const announceCopy = (code) => {
          const msg = `คัดลอกโค้ด ${code} แล้ว — วางที่หน้าชำระเงินได้เลย`;
          if (liveRegion) liveRegion.textContent = msg;
          if (copyToast) {
            copyToast.textContent = msg;
            copyToast.classList.add('is-visible');
            window.clearTimeout(toastTimer);
            toastTimer = window.setTimeout(() => {
              copyToast.classList.remove('is-visible');
            }, 2600);
          }
        };

        document.addEventListener('click', (event) => {
          const anchor = event.target instanceof Element ? event.target.closest('a[href]') : null;
          if (anchor instanceof HTMLAnchorElement) {
            applySubId3(anchor);
            const autoCode = anchor.getAttribute('data-autocopy');
            if (autoCode && navigator.clipboard) {
              navigator.clipboard.writeText(autoCode).then(() => announceCopy(autoCode)).catch(() => {});
            }
            try {
              const url = new URL(anchor.href);
              const partner = clean(anchor.dataset.partner || '') || detectPartner(url.hostname);
              if (partner && typeof window.fbq === 'function') {
                const payload = {
                  partner,
                  page_path: window.location.pathname,
                };
                if (utm.utm_source) payload.utm_source = utm.utm_source;
                if (utm.utm_medium) payload.utm_medium = utm.utm_medium;
                if (utm.utm_campaign) payload.utm_campaign = utm.utm_campaign;
                if (utm.utm_content) payload.utm_content = utm.utm_content;
                const subId1 = url.searchParams.get('subId1');
                const subId2 = url.searchParams.get('subId2');
                if (subId1) payload.sub_id1 = subId1;
                if (subId2) payload.sub_id2 = subId2;
                window.fbq('trackCustom', 'OutboundAffiliateClick', payload);
              }
            } catch {}
          }

          const btn = event.target instanceof Element ? event.target.closest('[data-copy]') : null;
          if (!btn) return;
          const value = btn.getAttribute('data-copy');
          if (!value || !navigator.clipboard) return;
          const original = btn.textContent;
          navigator.clipboard
            .writeText(value)
            .then(() => {
              btn.textContent = 'คัดลอกแล้ว';
              announceCopy(value);
              window.setTimeout(() => {
                btn.textContent = original;
              }, 1800);
            })
            .catch(() => {});
        });

        // Sticky mobile CTA bar: reveal only when scrolled past QuickPick and bottom TicketCta is offscreen
        const stickyBar = document.querySelector('[data-sticky-cta]');
        const quickPick = document.querySelector('.quick-pick');
        const bottomTicket = document.querySelector('.ticket');
        if (stickyBar && quickPick) {
          let rafId = 0;
          const syncSticky = () => {
            rafId = 0;
            const qpRect = quickPick.getBoundingClientRect();
            const passedTop = qpRect.bottom < 0;
            let bottomVisible = false;
            if (bottomTicket) {
              const btRect = bottomTicket.getBoundingClientRect();
              bottomVisible = btRect.top < window.innerHeight && btRect.bottom > 0;
            }
            const shouldHide = !(passedTop && !bottomVisible);
            if (shouldHide && stickyBar.contains(document.activeElement)) {
              document.activeElement.blur();
            }
            stickyBar.hidden = shouldHide;
          };

          const scheduleSync = () => {
            if (!rafId) rafId = window.requestAnimationFrame(syncSticky);
          };

          if ('IntersectionObserver' in window) {
            const io = new IntersectionObserver(scheduleSync, { threshold: 0 });
            io.observe(quickPick);
            if (bottomTicket) io.observe(bottomTicket);
          }
          window.addEventListener('scroll', scheduleSync, { passive: true });
          window.addEventListener('resize', scheduleSync, { passive: true });
          syncSticky();
        }

        // Enhance Markdown tables with keyboard-scrollable region, scope="col", and scrollability shadow hints
        document.querySelectorAll('.prose table').forEach((table) => {
          if (table.closest('[data-table-wrap]')) return;
          table.querySelectorAll('thead th').forEach((th) => {
            if (!th.hasAttribute('scope')) th.setAttribute('scope', 'col');
          });
          const figure = document.createElement('div');
          figure.className = 'table-figure';
          figure.setAttribute('data-table-wrap', '');

          const wrap = document.createElement('div');
          wrap.className = 'table-wrap';

          const scroller = document.createElement('div');
          scroller.className = 'table-scroller';
          scroller.setAttribute('tabindex', '0');
          scroller.setAttribute('role', 'region');
          scroller.setAttribute('aria-label', 'ตารางเปรียบเทียบแพ็กเกจ');

          const hint = document.createElement('p');
          hint.className = 'table-scroll-hint';
          hint.setAttribute('aria-hidden', 'true');
          hint.textContent = 'เลื่อนซ้าย-ขวาเพื่อดูครบทุกคอลัมน์ →';

          table.parentNode?.insertBefore(figure, table);
          scroller.appendChild(table);
          wrap.appendChild(scroller);
          figure.appendChild(wrap);
          figure.appendChild(hint);
        });

        const tableWraps = document.querySelectorAll('[data-table-wrap]');
        tableWraps.forEach((wrap) => {
          const scroller = wrap.querySelector('.table-scroller');
          if (!scroller) return;
          const updateTableScroll = () => {
            const maxScroll = scroller.scrollWidth - scroller.clientWidth;
            const hasOverflow = maxScroll > 2;
            wrap.classList.toggle('has-overflow', hasOverflow);
            wrap.classList.toggle('can-scroll-start', hasOverflow && scroller.scrollLeft > 2);
            wrap.classList.toggle(
              'can-scroll-end',
              hasOverflow && scroller.scrollLeft < maxScroll - 2
            );
          };
          scroller.addEventListener('scroll', updateTableScroll, { passive: true });
          if ('ResizeObserver' in window) {
            new ResizeObserver(updateTableScroll).observe(scroller);
          } else {
            window.addEventListener('resize', updateTableScroll, { passive: true });
          }
          updateTableScroll();
        });
      })();
    </script>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        alt=""
        src="https://www.facebook.com/tr?id=1204328895355336&ev=PageView&noscript=1"
      />
    </noscript>
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token":"616ef818d42443429ee1449c6f2836b2"}'
    ></script>
  </body>
</html>
