const initial = PLANS.japan;
const initialTier = initial.tiers.standard;
---

<section class="recommender" aria-label="เช็กแพ็ก eSIM คุ้มสุดใน 10 วิ">
  <div class="recommender__head">
    <span class="recommender__eyebrow">FLIGHT BOARD PICKER</span>
    <h2>เช็กแพ็ก eSIM คุ้มสุดใน 10 วิ</h2>
  </div>

  <div class="recommender__controls">
    <div class="recommender__group" role="group" aria-label="เลือกประเทศปลายทาง">
      <span class="recommender__label">ปลายทาง</span>
      <div class="recommender__pills" data-rec-countries>
        {Object.entries(PLANS).map(([key, item], idx) => (
          <button
            type="button"
            class={`pill${idx === 0 ? ' is-active' : ''}`}
            data-country={key}
          >
            {item.label}
          </button>
        ))}
      </div>
    </div>

    <div class="recommender__group" role="group" aria-label="เลือกการใช้งาน">
      <span class="recommender__label">ปริมาณเน็ต</span>
      <div class="recommender__pills" data-rec-tiers>
        <button type="button" class="pill" data-tier="light">เบา (3–5 วัน · 3GB)</button>
        <button type="button" class="pill is-active" data-tier="standard">ทั่วไป (5–7 วัน · 5GB)</button>
        <button type="button" class="pill" data-tier="heavy">หนัก (7–15+ วัน · 10GB)</button>
      </div>
    </div>
  </div>

  <div class="recommender__result">
    <div class="recommender__meta">
      <strong data-rec-name>{initial.operator} ({initial.label})</strong>
      <span class="recommender__net" data-rec-network>เครือข่าย: {initial.network}</span>
      <div class="recommender__specs">
        <span data-rec-spec>{initialTier.data} / {initialTier.days}</span>
        <span>·</span>
        <span data-rec-price>ราคา {initialTier.price}</span>
        <span class="recommender__disc" data-rec-disc>ลดครั้งแรก 15% เหลือ {initialTier.disc}</span>
      </div>
      <div class="quick-pick__code">
        โค้ดส่วนลด: <code>NEWTOAIRALO15</code>
        <button class="copy-code" type="button" data-copy="NEWTOAIRALO15">คัดลอกโค้ด</button>
      </div>
    </div>
    <div class="recommender__actions">
      <a class="btn" data-rec-cta href={initial.link} rel="sponsored nofollow" target="_blank">
        ดูราคาและสมัคร Airalo
      </a>
      <a class="recommender__guide" data-rec-guide href={initial.guide}>
        เทียบ 5 ค่ายใน{initial.label} →
      </a>
    </div>
  </div>
</section>

<script is:inline define:vars={{ PLANS }}>
  (() => {
    const root = document.querySelector('.recommender');
    if (!root) return;
    let country = 'japan';
    let tier = 'standard';

    const nameEl = root.querySelector('[data-rec-name]');
    const netEl = root.querySelector('[data-rec-network]');
    const specEl = root.querySelector('[data-rec-spec]');
    const priceEl = root.querySelector('[data-rec-price]');
    const discEl = root.querySelector('[data-rec-disc]');
    const ctaEl = root.querySelector('[data-rec-cta]');
    const guideEl = root.querySelector('[data-rec-guide]');

    function render() {
      const plan = PLANS[country];
      const t = plan.tiers[tier];
      if (!plan || !t) return;
      nameEl.textContent = `${plan.operator} (${plan.label})`;
      netEl.textContent = `เครือข่าย: ${plan.network}`;
      specEl.textContent = `${t.data} / ${t.days}`;
      priceEl.textContent = `ราคา ${t.price}`;
      discEl.textContent = `ลดครั้งแรก 15% เหลือ ${t.disc}`;
      ctaEl.setAttribute('href', plan.link);
      guideEl.setAttribute('href', plan.guide);
      guideEl.textContent = `เทียบ 5 ค่ายใน${plan.label} →`;
    }

    root.addEventListener('click', (e) => {
      const btn = e.target instanceof Element ? e.target.closest('button[data-country], button[data-tier]') : null;
      if (!btn) return;
      const c = btn.getAttribute('data-country');
      const t = btn.getAttribute('data-tier');
      if (c && PLANS[c]) {
        country = c;
        root.querySelectorAll('[data-country]').forEach((el) => el.classList.toggle('is-active', el === btn));
        render();
      } else if (t) {
        tier = t;
        root.querySelectorAll('[data-tier]').forEach((el) => el.classList.toggle('is-active', el === btn));
        render();
      }
    });
  })();
</script>
