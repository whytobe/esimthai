    guide: '/blog/esim-taiwan/',
    tiers: {
      light: { data: '3 GB', days: '7 วัน', price: '~฿306', disc: '~฿260' },
      standard: { data: '5 GB', days: '7 วัน', price: '~฿374', disc: '~฿318' },
      heavy: { data: '10 GB', days: '30 วัน', price: '~฿646', disc: '~฿549' },
    },
  },
  vietnam: {
    label: 'เวียดนาม',
    network: 'VNPT 5G',
    operator: 'Airalo Xin Chao',
    link: 'https://airalo.pxf.io/aNgPjq?subId1=home-picker&subId2=vietnam',
    guide: '/blog/esim-vietnam/',
    tiers: {
