---
import { VACAY_CODE, discountedThbPrice, vacayUrlFor } from '../lib/affiliate';

interface Props {
  link: string;
  name: string;
  data: string;
  days: string;
  price: string;
  code?: string;
  slug?: string;
}

const { link, name, data, days, price, code, slug } = Astro.props;
const discounted = code ? discountedThbPrice(price, 15) : undefined;
const vacayHref = vacayUrlFor(slug);
---

<aside class="quick-pick" aria-label="แพ็กเกจแนะนำ">
  <div class="quick-pick__row">
    <div class="quick-pick__info">
      <span class="quick-pick__label">แนะนำสำหรับทริปนี้</span>
      <div class="quick-pick__title">
        <strong>{name}</strong> · {data} / {days}
      </div>
      <div class="quick-pick__pricing">
        {discounted ? (
          <>
            <s class="quick-pick__old-price">{price}</s>
            <span class="quick-pick__price">{discounted}</span>
            <span class="quick-pick__badge">ลด 15% ลูกค้าใหม่</span>
          </>
        ) : (
          <span class="quick-pick__price">{price}</span>
        )}
      </div>
      {code && (
        <div class="quick-pick__code">
          <span>โค้ด <code>{code}</code></span>
          <button
            class="copy-code"
            type="button"
            data-copy={code}
            aria-label={`คัดลอกโค้ดส่วนลด Airalo ${code}`}
          >
            คัดลอกโค้ด
          </button>
        </div>
      )}
    </div>
    <a
      class="btn quick-pick__cta"
      href={link}
      data-partner="airalo"
      data-autocopy={code || undefined}
      rel="sponsored nofollow noopener"
      target="_blank"
    >
      {code ? `คัดลอกโค้ด + ไปหน้า Airalo` : `ดูราคา Airalo`}
    </a>
  </div>
  <div class="quick-pick__alt">
    <div class="quick-pick__alt-copy">
      <strong>จ่าย PromptPay / เมนูไทย?</strong> <strong>Vacay eSIM</strong> · โค้ด
      <code>{VACAY_CODE}</code>
      <button
        class="copy-code"
        type="button"
        data-copy={VACAY_CODE}
        aria-label={`คัดลอกโค้ดส่วนลด Vacay ${VACAY_CODE}`}
      >
        คัดลอกโค้ด
      </button>
    </div>
    <a
      class="btn btn--secondary"
      href={vacayHref}
      data-partner="vacay"
      data-autocopy={VACAY_CODE}
      rel="sponsored nofollow noopener"
      target="_blank"
    >
      ดูแพ็ก Vacay (PromptPay)
    </a>
  </div>
  <div class="quick-pick__trust">
    <span>ติดตั้งก่อนบินได้ทันที</span>
    <span>เปิดซิมไทยรับ OTP ได้</span>
  </div>
  <details class="eid-check">
    <summary class="eid-check__summary">
      เช็กมือถือรองรับ eSIM ใน 5 วิ (กด <code>*#06#</code>)
    </summary>
    <div class="eid-check__body">
      <ol>
        <li>เปิดแอปโทรศัพท์แล้วกด <code>*#06#</code> (ไม่ต้องกดโทรออก)</li>
        <li>ถ้าขึ้นรหัส <strong>EID</strong> (ตัวเลข 32 หลัก) = เครื่องรองรับ eSIM ใช้ได้ทันที</li>
        <li>
          รองรับ iPhone XS/XR ขึ้นไป (ยกเว้นเครื่องศูนย์จีน/ฮ่องกง 2 ซิมจริง) และ Android รุ่นที่รองรับ ·{' '}
          <a href="/blog/what-is-esim/">ดูรายชื่อรุ่นทั้งหมด →</a>
        </li>
      </ol>
    </div>
  </details>
</aside>
