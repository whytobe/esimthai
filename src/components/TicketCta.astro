---
import { VACAY_CODE, VACAY_REF_URL } from '../lib/affiliate';

interface Props {
  link: string;
  name: string;
  data: string;
  days: string;
  price: string;
  code?: string;
}

const { link, name, data, days, price, code } = Astro.props;
---

<div class="ticket">
  <div class="ticket__main">
    <h3>{name}</h3>
    <p>แพ็กเกจคุ้มสำหรับทริป {days} — ต่อเน็ตทันทีหลังถึง ไม่ต้องเปลี่ยนซิม</p>
    <div class="ticket__actions">
      <a class="btn" href={link} data-partner="airalo" rel="sponsored nofollow noopener" target="_blank">ดูราคาและสมัคร Airalo</a>
      <a class="btn btn--secondary" href={VACAY_REF_URL} data-partner="vacay" rel="sponsored nofollow noopener" target="_blank">
        ดูแพ็ก Vacay (PromptPay)
      </a>
    </div>
    {code && (
      <p class="affiliate-note">
        Airalo ลด 15%: <code>{code}</code>{' '}
        <button class="copy-code" type="button" data-copy={code}>คัดลอกโค้ด</button>
        {' · '}Vacay จ่าย PromptPay โค้ด: <code>{VACAY_CODE}</code>{' '}
        <button class="copy-code" type="button" data-copy={VACAY_CODE}>คัดลอกโค้ด</button>
      </p>
    )}
  </div>
  <div class="ticket__stub">
    <span class="ticket__stub-label">เน็ต</span>
    <span class="ticket__stub-data">{data}</span>
    <span class="ticket__stub-label">วัน</span>
    <span class="ticket__stub-data">{days}</span>
    <span class="ticket__stub-label">ราคา</span>
    <span class="ticket__stub-price">{price}</span>
  </div>
</div>
